# Copy this file to .env for local experiments.
# Do not commit real API keys.

# Qwen Flash (OpenAI-compatible)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-flash

# Image generation provider
# dashscope = cloud image generation for release demos
# sd-webui = optional local Stable Diffusion WebUI
IMAGE_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_ENDPOINT=/services/aigc/multimodal-generation/generation
DASHSCOPE_IMAGE_MODEL=wan2.7-image
DASHSCOPE_IMAGE_SIZE=1K
DASHSCOPE_IMAGE_WATERMARK=false
DASHSCOPE_IMAGE_THINKING_MODE=false
DASHSCOPE_MAX_INPUT_IMAGES=2

# Optional local Stable Diffusion WebUI
SD_WEBUI_BASE_URL=http://127.0.0.1:7860
SD_WEBUI_USERNAME=
SD_WEBUI_PASSWORD=
PIXELRTXL_CHECKPOINT=
SD_FUSION_CHECKPOINT=
SD_TXT2IMG_WIDTH=1024
SD_TXT2IMG_HEIGHT=1024
SD_TXT2IMG_STEPS=24
SD_TXT2IMG_CFG_SCALE=7
SD_IMG2IMG_WIDTH=1024
SD_IMG2IMG_HEIGHT=1024
SD_IMG2IMG_STEPS=28
SD_IMG2IMG_CFG_SCALE=7
SD_IMG2IMG_DENOISING=0.58
SD_SAMPLER=DPM++ 2M Karras

# Local development
PORT=3001
VITE_API_BASE_URL=http://127.0.0.1:3001

# Runtime mode
AI_KITCHEN_USE_MOCK=true
AI_KITCHEN_REQUEST_TIMEOUT_MS=60000
AI_KITCHEN_RETRY_COUNT=1
AI_KITCHEN_SESSION_TTL_MS=1800000
